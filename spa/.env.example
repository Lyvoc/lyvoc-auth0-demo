# Optional: the portal reads its configuration from spa/src/config/demo.json
# (npm run config, from Terraform). These variables override it when set.
# Copy to .env (git-ignored).

# Auth0 application of the portal
# VITE_AUTH0_DOMAIN=
# VITE_AUTH0_CLIENT_ID=
# VITE_AUTH0_AUDIENCE=

# Customer branding
# VITE_CUSTOMER_NAME=
# VITE_LOGO_URL=
# VITE_PRIMARY_COLOR=
# VITE_SECONDARY_COLOR=
# VITE_BG_PRIMARY=
# VITE_BG_SECONDARY=
# VITE_BG_SIDEBAR=
# VITE_TEXT_PRIMARY=
# VITE_TEXT_SECONDARY=
# VITE_TEXT_MUTED=
