    "config": "node scripts/config.mjs",
    "web": "npm --prefix web-app start",
    "build": "vite build",
    "serve": "vite preview"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.8.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
